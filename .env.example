# PromptGuard configuration - copy to .env and adjust.
# Every value is optional; the defaults below are used when a variable is unset.

# Operating mode: LEARNING (log only) | MONITOR (warn) | ENFORCE (full policy)
PROMPTGUARD_MODE=ENFORCE

# Input limits
PROMPTGUARD_MAX_INPUT_CHARS=20000
PROMPTGUARD_MAX_DOCUMENT_CHARS=50000
PROMPTGUARD_MAX_DECODE_DEPTH=3

# Severity thresholds (score >= value)
PROMPTGUARD_THRESHOLD_LOW=20
PROMPTGUARD_THRESHOLD_MEDIUM=40
PROMPTGUARD_THRESHOLD_HIGH=60
PROMPTGUARD_THRESHOLD_CRITICAL=80

# Output firewall action when a leak is found: BLOCK | REDACT
PROMPTGUARD_OUTPUT_LEAK_ACTION=BLOCK

# Recipients send_demo_message may write to (comma separated)
PROMPTGUARD_RECIPIENT_ALLOWLIST=team@promptguard.local

# SQLite event log location
PROMPTGUARD_DB_PATH=data/promptguard.db

# LLM provider: mock (default, offline) | openai | anthropic
PROMPTGUARD_LLM_PROVIDER=mock

# Only needed for real providers. NEVER commit real keys.
OPENAI_API_KEY=
PROMPTGUARD_OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
PROMPTGUARD_ANTHROPIC_MODEL=claude-opus-5-5
